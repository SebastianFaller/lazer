--- a/hexl/util/cpu-features.hpp
+++ b/hexl/util/cpu-features.hpp
@@ -7,11 +7,15 @@
 
 #include <cstdlib>
 
+#if defined(__x86_64__) || defined(_M_X64)
 #include "cpuinfo_x86.h"  // NOLINT(build/include_subdir)
+#endif
 
 namespace intel {
 namespace hexl {
 
+#if defined(__x86_64__) || defined(_M_X64)
+
 // Use to disable avx512 dispatching at runtime
 static const bool disable_avx512dq =
     (std::getenv("HEXL_DISABLE_AVX512DQ") != nullptr);
@@ -31,5 +35,14 @@
 static const bool has_avx512vbmi2 =
     features.avx512vbmi2 && !disable_avx512vbmi2;
 
+#else
+
+// Non-x86 targets (e.g. aarch64): no AVX512, always use the native kernels.
+static const bool has_avx512dq = false;
+static const bool has_avx512ifma = false;
+static const bool has_avx512vbmi2 = false;
+
+#endif
+
 }  // namespace hexl
 }  // namespace intel
--- a/hexl/CMakeLists.txt
+++ b/hexl/CMakeLists.txt
@@ -93,10 +93,14 @@
 
 if (CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
     target_compile_options(hexl PRIVATE -Wall -Wconversion -Wshadow -pedantic -Wextra
-        -Wno-unknown-pragmas -march=native -O3 -fomit-frame-pointer
+        -Wno-unknown-pragmas -O3 -fomit-frame-pointer
         -Wno-sign-conversion
         -Wno-implicit-int-conversion
     )
+    # -march=native is only meaningful when building for the host
+    if (NOT CMAKE_CROSSCOMPILING)
+        target_compile_options(hexl PRIVATE -march=native)
+    endif()
     # Avoid 3rd-party dependency warnings when including HEXL as a dependency
     target_compile_options(hexl PUBLIC
